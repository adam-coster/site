---
import { version } from '../../package.json';
import { ldJsonify } from '../utilities/microdata.ts';
import { asCanonicalUrl } from '../utilities/urls.ts';

interface Props {
	meta: {
		title: string;
		description: string;
		ldjsons?: any[];
		social?: { title?: string; description?: string; image?: string };
		canonical: string;
	};
}
const { meta } = Astro.props;

const canonical = asCanonicalUrl(meta.canonical);
const ldjson = meta.ldjsons && ldJsonify(meta.ldjsons);
const year = new Date().getFullYear();

const navLinks: { url: string; name: string }[] = [
	{ name: 'About', url: '/about' },
	{ name: 'Podcast', url: 'https://podcast.bscotch.net' },
	{ name: 'Bluesky', url: 'https://bsky.app/profile/adamcoster.com' },
	{ name: 'GitHub', url: 'https://github.com/adam-coster' },
	{ name: 'RSS', url: '/feed.atom' },
];
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<meta name="robots" content="index, follow" />
		<!-- Feeds -->
		<link
			rel="alternate"
			type="application/atom+xml"
			href="/feed.atom"
			title="Adam Coster"
		/>
		<!-- Page Details -->
		<title>{meta.title}</title>
		<meta name="description" content={meta.description} />
		<meta property="og:title" content={meta.social?.title || meta.title} />
		<meta
			property="og:description"
			content={meta.social?.description || meta.description}
		/>
		{
			meta.social?.image && (
				<meta property="og:image" content={meta.social.image} />
			)
		}
		<meta property="og:url" content={canonical} />
		<link rel="canonical" href={canonical} />
		{ldjson && <script type="application/ld+json" set:html={ldjson} />}
	</head>
	<body>
		<header>
			<nav>
				<menu>
					<li>
						<a id="home-link" href="/" title="Home" aria-label="Home">
							<span class="first-name">adam</span><span class="last-name"
								>coster</span
							>
						</a>
					</li>
					{
						navLinks.map((link) => (
							<li>
								<a href={link.url}>{link.name}</a>
							</li>
						))
					}
				</menu>
			</nav>
		</header>
		<slot />
		<footer>
			<p>
				<span class="inline-block"
					>© <span id="copyright-year">{year}</span> Adam Coster.</span
				>
				<i class="inline-block">All rights reserved.</i>
				<span class="inline-block version">v{version}</span>
			</p>
		</footer>
	</body>
</html>
