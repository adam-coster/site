---
import YearRange from './YearRange.astro';

interface Props {
	title?: string;
	from: string | number;
	to?: string | number;
}
const { title, from, to } = Astro.props;
---

<article>
	<header>
		<h3>
			<span class="title">
				{title ? title : <slot name="title" />}
			</span>
			<span class="range">
				(<YearRange {from} {to} />)
			</span>
		</h3>
	</header>
	<div class="body">
		<slot />
	</div>
</article>
