---
import { getCollection, render } from 'astro:content';
import LayoutGlobal from '../../layouts/LayoutGlobal.astro';
import { createArticleMicrodata } from '../../utilities/microdata.ts';

export async function getStaticPaths() {
	const posts = await getCollection('articles');
	return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function readableDate(date: Date): string {
	return new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' }).format(
		date,
	);
}
---

<LayoutGlobal
	meta={{
		canonical: post.data.canonical || `/articles/${post.id}`,
		description: post.data.description,
		title: post.data.title,
		ldjsons: [createArticleMicrodata(post.data)],
	}}
>
	<main>
		<article>
			<header>
				<h1>{post.data.title}</h1>
				<ul aria-label="Tags">
					{post.data.tags.map((tag) => <li>{tag}</li>)}
				</ul>
				{
					post.data.editedAt && (
						<p>
							Updated
							<time datetime={post.data.editedAt.toISOString()}>
								{readableDate(post.data.editedAt)}
							</time>
						</p>
					)
				}
				{
					post.data.publishedAt && (
						<p>
							Published
							<time datetime={post.data.publishedAt.toISOString()}>
								{readableDate(post.data.publishedAt)}
							</time>
						</p>
					)
				}
			</header>

			<Content />
		</article>
	</main>
</LayoutGlobal>
