{
	"name": "@local/root",
	"private": true,
	"description": "Monorepo root, for managing shared dependencies, build scripts, etc.",
	"scripts": {
		"build": "node build.ts",
		"preview": "node preview.ts",
		"dev": "nodemon -e md,html,ts,js,json --watch content --watch templates --exec pnpm node preview.ts"
	},
	"dependencies": {
		"@hono/node-server": "1.19.9",
		"@tsconfig/node24": "24.0.4",
		"@types/lunr": "2.3.7",
		"@types/node": "22.10.5",
		"eslint": "9.17.0",
		"highlight.js": "11.11.1",
		"hono": "4.11.5",
		"lunr": "2.3.9",
		"marked": "17.0.1",
		"marked-highlight": "2.2.3",
		"nodemon": "3.1.11",
		"prettier": "3.4.2",
		"schema-dts": "1.1.5",
		"typescript": "5.7.2",
		"zod": "4.3.6"
	},
	"packageManager": "pnpm@8.3.1",
	"engines": {
		"node": ">=24"
	},
	"type": "module",
	"version": "0.0.1"
}
